<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_clay_surface"
    android:orientation="vertical"
    android:padding="@dimen/clay_padding">

    <TextView
        android:id="@+id/tvAyahNumber"
        style="@style/Clay.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvAyahText"
        style="@style/Clay.Arabic"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:lineSpacingExtra="8dp"
        android:textSize="24sp" />

    <TextView
        android:id="@+id/tvAyahTranslation"
        style="@style/Clay.Body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingExtra="2dp"
        android:textSize="14sp" />
</LinearLayout>
