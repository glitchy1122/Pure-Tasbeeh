<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/clay_bg"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_margin">

        <TextView
            android:id="@+id/tvScreenTitle"
            style="@style/Clay.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/menu_duas" />

        <TextView
            android:id="@+id/headerSingle"
            style="@style/Clay.TileLabel"
            android:layout_width="match_parent"
            android:layout_height="@dimen/header_box_height"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_clay_surface"
            android:gravity="center"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/headerDualRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/headerJafriya"
                style="@style/Clay.TileLabel"
                android:layout_width="match_parent"
                android:layout_height="@dimen/header_box_height"
                android:background="@drawable/bg_clay_button"
                android:gravity="center"
                android:text="@string/fiqh_jafriya" />

            <TextView
                android:id="@+id/headerHanfiya"
                style="@style/Clay.TileLabel"
                android:layout_width="match_parent"
                android:layout_height="@dimen/header_box_height"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_clay_button"
                android:gravity="center"
                android:text="@string/fiqh_hanfiya" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/categoryContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/catNamaz"
                style="@style/Clay.TileLabel"
                android:layout_width="match_parent"
                android:layout_height="@dimen/category_row_height"
                android:background="@drawable/bg_clay_button"
                android:gravity="center"
                android:text="@string/cat_namaz" />

            <TextView
                android:id="@+id/catSpecial"
                style="@style/Clay.TileLabel"
                android:layout_width="match_parent"
                android:layout_height="@dimen/category_row_height"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_clay_button"
                android:gravity="center"
                android:text="@string/cat_special" />

            <TextView
                android:id="@+id/catZiyaraat"
                style="@style/Clay.TileLabel"
                android:layout_width="match_parent"
                android:layout_height="@dimen/category_row_height"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_clay_button"
                android:gravity="center"
                android:text="@string/cat_ziyaraat" />

            <TextView
                android:id="@+id/catMunajat"
                style="@style/Clay.TileLabel"
                android:layout_width="match_parent"
                android:layout_height="@dimen/category_row_height"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_clay_button"
                android:gravity="center"
                android:text="@string/cat_munajat" />

            <TextView
                android:id="@+id/catAamal"
                style="@style/Clay.TileLabel"
                android:layout_width="match_parent"
                android:layout_height="@dimen/category_row_height"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_clay_button"
                android:gravity="center"
                android:text="@string/cat_aamal" />

            <TextView
                android:id="@+id/catDaily"
                style="@style/Clay.TileLabel"
                android:layout_width="match_parent"
                android:layout_height="@dimen/category_row_height"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_clay_button"
                android:gravity="center"
                android:text="@string/cat_daily" />
        </LinearLayout>

        <TextView
            android:id="@+id/catSahifa"
            style="@style/Clay.TileLabel"
            android:layout_width="match_parent"
            android:layout_height="@dimen/category_row_height"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_clay_button"
            android:gravity="center"
            android:text="@string/cat_sahifa" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
