<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/clay_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_margin">

        <TextView
            android:id="@+id/tvScreenTitle"
            style="@style/Clay.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/menu_duas" />

        <!-- Single-fiqh mode header -->
        <TextView
            android:id="@+id/headerSingle"
            style="@style/Clay.TileLabel"
            android:layout_width="match_parent"
            android:layout_height="@dimen/header_box_height"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_clay_surface"
            android:gravity="center"
            android:visibility="gone" />

        <!-- Dual-fiqh mode headers -->
        <LinearLayout
            android:id="@+id/headerDualRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/headerJafriya"
                style="@style/Clay.TileLabel"
                android:layout_width="match_parent"
                android:layout_height="@dimen/header_box_height"
                android:background="@drawable/bg_clay_button"
                android:gravity="center"
                android:text="@string/fiqh_jafriya" />

            <TextView
                android:id="@+id/headerHanfiya"
                style="@style/Clay.TileLabel"
                android:layout_width="match_parent"
                android:layout_height="@dimen/header_box_height"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_clay_button"
                android:gravity="center"
                android:text="@string/fiqh_hanfiya" />
        </LinearLayout>

        <!-- Category tiles (shown in single mode, or after picking a sect in dual) -->
        <LinearLayout
            android:id="@+id/categoryContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/catNamaz"
                style="@style/Clay.TileLabel"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:background="@drawable/bg_clay_button"
                android:gravity="center"
                android:text="@string/cat_namaz" />

            <TextView
                android:id="@+id/catSpecial"
                style="@style/Clay.TileLabel"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_clay_button"
                android:gravity="center"
                android:text="@string/cat_special" />

            <TextView
                android:id="@+id/catMonths"
                style="@style/Clay.TileLabel"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_clay_button"
                android:gravity="center"
                android:text="@string/cat_months" />

            <TextView
                android:id="@+id/catDaily"
                style="@style/Clay.TileLabel"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_clay_button"
                android:gravity="center"
                android:text="@string/cat_daily" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
