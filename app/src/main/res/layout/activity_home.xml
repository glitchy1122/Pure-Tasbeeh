<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/clay_bg"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/screen_margin"
        android:paddingBottom="32dp">

        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="@dimen/settings_icon_size"
            android:layout_height="@dimen/settings_icon_size"
            android:background="@drawable/bg_clay_button"
            android:contentDescription="@string/settings_title"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_menu_hamburger"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvBrand"
            style="@style/Clay.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:text="@string/app_name"
            app:layout_constraintEnd_toStartOf="@id/btnSettings"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvDate"
            style="@style/Clay.Body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="13sp"
            app:layout_constraintEnd_toStartOf="@id/btnSettings"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvBrand" />

        <!-- Sun / Moon animated sky estimate -->
        <LinearLayout
            android:id="@+id/skyPanel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_clay_surface"
            android:orientation="vertical"
            android:padding="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvDate">

            <TextView
                android:id="@+id/tvSkyLabel"
                style="@style/Clay.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="12sp"
                android:textStyle="bold" />

            <com.adreesulhassan.puretasbeeh.ui.sky.AnimatedSkyView
                android:id="@+id/animatedSky"
                android:layout_width="match_parent"
                android:layout_height="@dimen/sky_panel_height"
                android:layout_marginTop="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvSunEstimate"
                    style="@style/Clay.Body"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/tvMoonEstimate"
                    style="@style/Clay.Body"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Prayer times strip -->
        <LinearLayout
            android:id="@+id/prayerStrip"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_clay_surface"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="10dp"
            android:weightSum="5"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/skyPanel">

            <include
                android:id="@+id/prayerFajr"
                layout="@layout/item_prayer_chip"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <include
                android:id="@+id/prayerDhuhr"
                layout="@layout/item_prayer_chip"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <include
                android:id="@+id/prayerAsr"
                layout="@layout/item_prayer_chip"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <include
                android:id="@+id/prayerMaghrib"
                layout="@layout/item_prayer_chip"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <include
                android:id="@+id/prayerIsha"
                layout="@layout/item_prayer_chip"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- Hadith of the Day -->
        <LinearLayout
            android:id="@+id/hadithBanner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_clay_surface"
            android:orientation="vertical"
            android:padding="@dimen/clay_padding"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/prayerStrip">

            <TextView
                android:id="@+id/tvHadithLabel"
                style="@style/Clay.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/hadith_of_the_day"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHadithArabic"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvHadithTranslation"
                style="@style/Clay.HadithQuote"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp" />

            <TextView
                android:id="@+id/tvHadithSource"
                style="@style/Clay.Caption"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textStyle="italic" />
        </LinearLayout>

        <!-- Grid menu -->
        <GridLayout
            android:id="@+id/menuGrid"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:alignmentMode="alignBounds"
            android:columnCount="2"
            android:columnOrderPreserved="false"
            android:useDefaultMargins="false"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/hadithBanner">

            <TextView
                android:id="@+id/tileQuran"
                style="@style/Clay.TileLabel"
                android:layout_width="0dp"
                android:layout_height="@dimen/tile_min_height"
                android:layout_columnWeight="1"
                android:layout_marginEnd="@dimen/tile_grid_gap"
                android:layout_marginBottom="@dimen/tile_grid_gap"
                android:background="@drawable/bg_clay_button"
                android:gravity="center"
                android:padding="12dp"
                android:text="@string/menu_quran" />

            <TextView
                android:id="@+id/tileDuas"
                style="@style/Clay.TileLabel"
                android:layout_width="0dp"
                android:layout_height="@dimen/tile_min_height"
                android:layout_columnWeight="1"
                android:layout_marginBottom="@dimen/tile_grid_gap"
                android:background="@drawable/bg_clay_button"
                android:gravity="center"
                android:padding="12dp"
                android:text="@string/menu_duas" />

            <TextView
                android:id="@+id/tileZehra"
                style="@style/Clay.TileLabel"
                android:layout_width="0dp"
                android:layout_height="@dimen/tile_min_height"
                android:layout_columnWeight="1"
                android:layout_marginEnd="@dimen/tile_grid_gap"
                android:layout_marginBottom="@dimen/tile_grid_gap"
                android:background="@drawable/bg_clay_button"
                android:gravity="center"
                android:padding="12dp"
                android:text="@string/menu_tasbeeh_zehra" />

            <TextView
                android:id="@+id/tileCustom"
                style="@style/Clay.TileLabel"
                android:layout_width="0dp"
                android:layout_height="@dimen/tile_min_height"
                android:layout_columnWeight="1"
                android:layout_marginBottom="@dimen/tile_grid_gap"
                android:background="@drawable/bg_clay_button"
                android:gravity="center"
                android:padding="12dp"
                android:text="@string/menu_custom_tasbeeh" />

            <TextView
                android:id="@+id/tileAhadith"
                style="@style/Clay.TileLabel"
                android:layout_width="0dp"
                android:layout_height="@dimen/tile_min_height"
                android:layout_columnWeight="1"
                android:layout_marginEnd="@dimen/tile_grid_gap"
                android:layout_marginBottom="@dimen/tile_grid_gap"
                android:background="@drawable/bg_clay_button"
                android:gravity="center"
                android:padding="12dp"
                android:text="@string/menu_ahadith" />

            <TextView
                android:id="@+id/tileBooks"
                style="@style/Clay.TileLabel"
                android:layout_width="0dp"
                android:layout_height="@dimen/tile_min_height"
                android:layout_columnWeight="1"
                android:layout_marginBottom="@dimen/tile_grid_gap"
                android:background="@drawable/bg_clay_button"
                android:gravity="center"
                android:padding="10dp"
                android:text="@string/menu_books" />

            <TextView
                android:id="@+id/tileFaal"
                style="@style/Clay.TileLabel"
                android:layout_width="0dp"
                android:layout_height="@dimen/category_row_height"
                android:layout_columnSpan="2"
                android:layout_columnWeight="1"
                android:background="@drawable/bg_clay_button"
                android:gravity="center"
                android:padding="8dp"
                android:text="@string/menu_faal" />
        </GridLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
