<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/clay_bg"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/screen_margin"
        android:paddingBottom="32dp">

        <TextView
            android:id="@+id/tvBrand"
            style="@style/Clay.Title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/app_name"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvDate"
            style="@style/Clay.Body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvBrand" />

        <!-- Prayer times strip -->
        <LinearLayout
            android:id="@+id/prayerStrip"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_clay_surface"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="10dp"
            android:weightSum="5"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvDate">

            <include
                android:id="@+id/prayerFajr"
                layout="@layout/item_prayer_chip"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <include
                android:id="@+id/prayerDhuhr"
                layout="@layout/item_prayer_chip"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <include
                android:id="@+id/prayerAsr"
                layout="@layout/item_prayer_chip"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <include
                android:id="@+id/prayerMaghrib"
                layout="@layout/item_prayer_chip"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <include
                android:id="@+id/prayerIsha"
                layout="@layout/item_prayer_chip"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- Hadith of the Day -->
        <LinearLayout
            android:id="@+id/hadithBanner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_clay_surface"
            android:orientation="vertical"
            android:padding="@dimen/clay_padding"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/prayerStrip">

            <TextView
                android:id="@+id/tvHadithLabel"
                style="@style/Clay.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/hadith_of_the_day"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvHadithArabic"
                style="@style/Clay.Arabic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/tvHadithTranslation"
                style="@style/Clay.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp" />

            <TextView
                android:id="@+id/tvHadithSource"
                style="@style/Clay.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="12sp"
                android:textStyle="italic" />
        </LinearLayout>

        <!-- Grid menu -->
        <GridLayout
            android:id="@+id/menuGrid"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:alignmentMode="alignMargins"
            android:columnCount="2"
            android:useDefaultMargins="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/hadithBanner">

            <TextView
                android:id="@+id/tileQuran"
                style="@style/Clay.TileLabel"
                android:layout_width="0dp"
                android:layout_height="@dimen/tile_min_height"
                android:layout_columnWeight="1"
                android:background="@drawable/bg_clay_button"
                android:gravity="center"
                android:padding="12dp"
                android:text="@string/menu_quran" />

            <TextView
                android:id="@+id/tileDuas"
                style="@style/Clay.TileLabel"
                android:layout_width="0dp"
                android:layout_height="@dimen/tile_min_height"
                android:layout_columnWeight="1"
                android:background="@drawable/bg_clay_button"
                android:gravity="center"
                android:padding="12dp"
                android:text="@string/menu_duas" />

            <TextView
                android:id="@+id/tileZehra"
                style="@style/Clay.TileLabel"
                android:layout_width="0dp"
                android:layout_height="@dimen/tile_min_height"
                android:layout_columnWeight="1"
                android:background="@drawable/bg_clay_button"
                android:gravity="center"
                android:padding="12dp"
                android:text="@string/menu_tasbeeh_zehra" />

            <TextView
                android:id="@+id/tileCustom"
                style="@style/Clay.TileLabel"
                android:layout_width="0dp"
                android:layout_height="@dimen/tile_min_height"
                android:layout_columnWeight="1"
                android:background="@drawable/bg_clay_button"
                android:gravity="center"
                android:padding="12dp"
                android:text="@string/menu_custom_tasbeeh" />

            <TextView
                android:id="@+id/tileBooks"
                style="@style/Clay.TileLabel"
                android:layout_width="0dp"
                android:layout_height="@dimen/tile_min_height"
                android:layout_columnSpan="2"
                android:layout_columnWeight="1"
                android:background="@drawable/bg_clay_button"
                android:gravity="center"
                android:padding="12dp"
                android:text="@string/menu_books" />
        </GridLayout>

        <TextView
            android:id="@+id/btnFiqhSettings"
            style="@style/Clay.TileLabel"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_clay_button"
            android:gravity="center"
            android:text="@string/fiqh_settings"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/menuGrid" />

        <TextView
            android:id="@+id/tvLicense"
            style="@style/Clay.Body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:text="@string/app_license_notice"
            android:textSize="11sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/btnFiqhSettings" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
