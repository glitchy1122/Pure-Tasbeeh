<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/clay_bg"
    android:padding="@dimen/screen_margin">

    <TextView
        android:id="@+id/tvTitle"
        style="@style/Clay.Title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/custom_tasbeeh_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvFeelingLabel"
        style="@style/Clay.Body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/how_are_you_feeling"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitle" />

    <EditText
        android:id="@+id/etFeeling"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_clay_surface"
        android:hint="@string/feeling_hint"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLines="2"
        android:padding="14dp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_muted"
        app:layout_constraintEnd_toStartOf="@id/btnGetZikr"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvFeelingLabel" />

    <TextView
        android:id="@+id/btnGetZikr"
        style="@style/Clay.TileLabel"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/bg_clay_button"
        android:gravity="center"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:text="@string/get_zikr"
        app:layout_constraintBottom_toBottomOf="@id/etFeeling"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/etFeeling"
        app:layout_constraintTop_toTopOf="@id/etFeeling" />

    <TextView
        android:id="@+id/tvZikrArabic"
        style="@style/Clay.Arabic"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="@string/default_zikr"
        android:textAlignment="center"
        android:textSize="28sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/etFeeling" />

    <TextView
        android:id="@+id/tvZikrTranslit"
        style="@style/Clay.Body"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Subhanallah"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvZikrArabic" />

    <LinearLayout
        android:id="@+id/targetRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvZikrTranslit">

        <TextView
            style="@style/Clay.Body"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/target_count_label"
            android:textColor="@color/text_primary" />

        <EditText
            android:id="@+id/etTarget"
            android:layout_width="88dp"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_clay_surface"
            android:gravity="center"
            android:importantForAutofill="no"
            android:inputType="number"
            android:maxLength="5"
            android:padding="10dp"
            android:text="33"
            android:textColor="@color/text_primary" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvCount"
        style="@style/Clay.Counter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="0"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/targetRow" />

    <FrameLayout
        android:id="@+id/btnTap"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_clay_button_round"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintBottom_toTopOf="@id/btnReset"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvCount"
        app:layout_constraintVertical_weight="1">

        <TextView
            style="@style/Clay.TileLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/tap_to_count"
            android:textSize="18sp" />
    </FrameLayout>

    <TextView
        android:id="@+id/btnReset"
        style="@style/Clay.TileLabel"
        android:layout_width="0dp"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_clay_button"
        android:gravity="center"
        android:text="@string/reset"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ProgressBar
        android:id="@+id/progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/etFeeling"
        app:layout_constraintEnd_toEndOf="@id/btnGetZikr"
        app:layout_constraintStart_toStartOf="@id/btnGetZikr"
        app:layout_constraintTop_toTopOf="@id/etFeeling" />

</androidx.constraintlayout.widget.ConstraintLayout>
