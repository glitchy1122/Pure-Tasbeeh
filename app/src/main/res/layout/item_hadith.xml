<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_clay_surface"
    android:orientation="vertical"
    android:padding="@dimen/clay_padding">

    <TextView
        android:id="@+id/tvHadithArabic"
        style="@style/Clay.Arabic"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/tvHadithTranslation"
        style="@style/Clay.ListRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:lineSpacingExtra="2dp" />

    <TextView
        android:id="@+id/tvHadithSource"
        style="@style/Clay.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textStyle="italic" />
</LinearLayout>
