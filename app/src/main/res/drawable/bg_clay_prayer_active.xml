<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="1dp"
        android:top="2dp"
        android:right="0dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#442C1810" />
            <corners android:radius="@dimen/clay_radius_small" />
        </shape>
    </item>
    <item
        android:left="0dp"
        android:top="0dp"
        android:right="1dp"
        android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/prayer_highlight" />
            <corners android:radius="@dimen/clay_radius_small" />
            <stroke
                android:width="1.5dp"
                android:color="@color/clay_highlight" />
        </shape>
    </item>
</layer-list>
