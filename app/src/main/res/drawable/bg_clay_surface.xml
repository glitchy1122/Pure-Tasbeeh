<?xml version="1.0" encoding="utf-8"?>
<!-- Soft elevated surface — iOS-style card on warm clay -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="0dp"
        android:top="1dp"
        android:right="0dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#14000000" />
            <corners android:radius="@dimen/clay_radius" />
        </shape>
    </item>
    <item
        android:bottom="1.5dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/clay_surface" />
            <corners android:radius="@dimen/clay_radius" />
            <stroke
                android:width="0.5dp"
                android:color="@color/tile_stroke" />
        </shape>
    </item>
</layer-list>
