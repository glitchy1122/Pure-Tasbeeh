<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/clay_surface_pressed" />
            <corners android:radius="@dimen/clay_radius" />
            <stroke
                android:width="1dp"
                android:color="@color/clay_shadow_dark" />
        </shape>
    </item>
    <item
        android:left="8dp"
        android:top="8dp"
        android:right="4dp"
        android:bottom="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#338B6B52" />
            <corners android:radius="18dp" />
        </shape>
    </item>
</layer-list>
