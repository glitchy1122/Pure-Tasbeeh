<?xml version="1.0" encoding="utf-8"?>
<!-- Menu tile — soft inset clay fill -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/clay_surface_pressed" />
            <corners android:radius="@dimen/clay_radius" />
            <stroke
                android:width="1dp"
                android:color="@color/clay_shadow_dark" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/tile_fill" />
            <corners android:radius="@dimen/clay_radius" />
            <stroke
                android:width="1dp"
                android:color="@color/tile_stroke" />
        </shape>
    </item>
</selector>
